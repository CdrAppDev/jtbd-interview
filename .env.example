# Server-side secrets. Set these in Vercel, never commit values.

# Fellow Developer API. The key is personal: the app sees what its owner sees.
FELLOW_API_KEY=
FELLOW_SUBDOMAIN=

# Anthropic developer platform, the app's own account.
ANTHROPIC_API_KEY=

# Ceiling on how much transcript one run may read. Default 600000.
ENGINE_MAX_INPUT_TOKENS=

# Optional overrides for Supabase. Defaults are in lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
